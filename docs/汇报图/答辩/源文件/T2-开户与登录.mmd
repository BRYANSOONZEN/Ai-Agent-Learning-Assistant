flowchart LR
    R1["<b>学生</b><br/>自己注册即可<br/>用户名 4～32 位<br/>密码 8～64 位<br/>含字母和数字"] --> U
    R2["<b>老师</b><br/>不能自己注册<br/><b>只能由管理员开通</b>"] --> U
    R3["<b>管理员</b><br/>系统初始化 1 个<br/>不开放注册<br/>也不能开通"] --> U
    U[("user 表<br/>只存 BCrypt<br/>哈希")] -- "登录：用户名<br/>+ 密码，不选角色" --> K1{锁定中?}
    K1 -- 是 --> E0["429 请 N 分钟<br/>后再试<br/>密码对也不行"]
    K1 -- 否 --> K2{"用户名存在<br/>且密码正确?"}
    K2 -- 否 --> E1["400 用户名或<br/>密码错误<br/>剩 2、1 次时提示<br/>连错 5 次锁 15 分钟"]
    K2 -- 是 --> K3{账号状态}
    K3 -- 0 禁用 --> E2["403 账号<br/>已被禁用"]
    K3 -- 1 正常 --> T["发 JWT 令牌<br/>24 小时有效<br/>按数据库里的角色<br/>学生 6 项菜单<br/>老师 4 项<br/>管理员 2 项"]
